        <list key="function_descriptions">
          <parameter key="REGION" value="if(Provincia == &quot;AZUAY&quot; || Provincia == &quot;BOLIVAR&quot; || Provincia == &quot;CAÑAR&quot; || Provincia == &quot;CARCHI&quot; || Provincia == &quot;CHIMBORAZO&quot; || Provincia == &quot;COTOPAXI&quot; || Provincia == &quot;IMBABURA&quot; || Provincia == &quot;LOJA&quot; || Provincia == &quot;PICHINCHA&quot; || Provincia == &quot;SANTO DOMINGO&quot; || Provincia == &quot;TUNGURAHUA&quot;, &quot;Sierra&quot;, &#10;if(Provincia == &quot;ESMERALDAS&quot; || Provincia == &quot;GUAYAS&quot; || Provincia == &quot;LOS RIOS&quot; || Provincia == &quot;MANABI&quot; || Provincia == &quot;EL ORO&quot; || Provincia == &quot;SANTA ELENA&quot;, &quot;Costa&quot;,&#10;if(Provincia == &quot;MORONA SANTIAGO&quot; || Provincia == &quot;NAPO&quot; || Provincia == &quot;ORELLANA&quot; || Provincia == &quot;PASTAZA&quot; || Provincia == &quot;SUCUMBIOS&quot; || Provincia == &quot;ZAMORA CHINCHIPE&quot;, &quot;Amazonía&quot;,&#10;if(Provincia == &quot;GALAPAGOS&quot;, &quot;Insular&quot;, &quot;DESCONOCIDO&quot;))))"/>
